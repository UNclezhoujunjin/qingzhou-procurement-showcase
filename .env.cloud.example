# Documentation only. Set these values as private environment variables in Render.
# Spring Boot does not automatically load this file.
SPRING_PROFILES_ACTIVE=cloud
# Choose Neon "Java" connection settings. Keep the password out of DB_URL.
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=verify-full
DB_USER=YOUR_NEON_DATABASE_USER
DB_PASSWORD=SET_ONLY_IN_RENDER
BOOTSTRAP_ADMIN_PASSWORD=CHOOSE_A_NEW_PRIVATE_PASSWORD_AT_LEAST_8_CHARACTERS
COOKIE_SECURE=true
